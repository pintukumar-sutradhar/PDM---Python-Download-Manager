
/* PDM Enterprise - Stability Optimized Stylesheet */

QWidget {
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
    color: #ffffff;
}

#central-widget {
    background-color: rgba(0, 0, 0, 0.7); 
}

/* Sidebar */
#sidebar {
    background-color: rgba(10, 11, 13, 0.95);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    min-width: 240px;
}

QPushButton#nav-btn {
    text-align: left;
    padding: 15px 25px;
    border: none;
    border-radius: 12px;
    margin: 4px 16px;
    background: transparent;
    color: #999999;
    font-weight: 600;
}

QPushButton#nav-btn:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #ffffff;
}

QPushButton#nav-btn:checked {
    background-color: #0078d4;
    color: #ffffff;
}

/* Toolbar */
QToolBar {
    background-color: rgba(10, 11, 13, 0.6);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    spacing: 12px;
    padding: 12px;
}

QPushButton#action-btn {
    background-color: rgba(45, 46, 50, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    padding: 8px 18px;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#action-btn:hover {
    background-color: #3d3e42;
    border: 1px solid #0078d4;
}

QPushButton#primary-btn {
    background-color: #0078d4;
    border: none;
    border-radius: 8px;
    padding: 10px 24px;
    color: white;
    font-weight: 700;
}

/* Table / View */
QTableView, QTableWidget {
    background-color: transparent;
    alternate-background-color: rgba(255, 255, 255, 0.02);
    border: none;
    gridline-color: transparent;
    outline: none;
}

QHeaderView::section {
    background-color: rgba(25, 26, 30, 1.0);
    color: #888888;
    padding: 12px;
    border: none;
    border-bottom: 2px solid #0078d4;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 11px;
}

/* Checkboxes & Selected Icons (Professional Style) */
QTableWidget::indicator:checked, QTableView::indicator:checked, QCheckBox::indicator:checked {
    background-color: #0078d4;
    border: 1px solid #00c6ff;
    image: url("PDM/assets/icons/check.png"); /* Optional if assets present */
    border-radius: 4px;
    width: 18px; height: 18px;
}

QTableWidget::indicator:unchecked, QTableView::indicator:unchecked, QCheckBox::indicator:unchecked {
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    width: 18px; height: 18px;
}

/* Inputs */
QLineEdit, QPlainTextEdit, QComboBox {
    background-color: rgba(0, 0, 0, 0.5);
    border: 1.5px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 10px;
    color: #ffffff;
}

QLineEdit:focus {
    border: 1.5px solid #0078d4;
}

QGroupBox {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    margin-top: 20px;
    padding-top: 15px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 20px;
    padding: 0 5px;
    color: #0078d4;
    font-weight: bold;
}
