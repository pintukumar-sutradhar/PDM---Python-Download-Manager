/* ============================================================
   PDM Enterprise — Professional Dark Theme
   ============================================================ */

* {
    font-family: "Inter", "Segoe UI", "SF Pro Display", "Roboto", sans-serif;
    font-size: 13px;
    color: #e8eaf2;
}

#mono-field {
    font-family: "JetBrains Mono", "Consolas", "DejaVu Sans Mono", monospace;
    font-size: 12px;
}

QMainWindow, #central-widget, QDialog {
    background-color: #0c0e14;
}

QWidget {
    background-color: transparent;
    color: #e8eaf2;
}

/* ------------------------------------------------------------
   Sidebar
   ------------------------------------------------------------ */
#sidebar {
    background-color: #11141c;
    border-right: 1px solid rgba(255, 255, 255, 0.05);
    min-width: 230px;
    max-width: 230px;
}

#brand-logo {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #6366f1, stop:1 #0ea5e9);
    color: #ffffff;
    font-size: 15px;
    font-weight: 900;
    border-radius: 10px;
    min-width: 46px;
    max-width: 46px;
    min-height: 46px;
    max-height: 46px;
}

#brand-title {
    font-family: "Rosehot free version", "Rosehot", "Inter", sans-serif;
    font-size: 17px;
    font-weight: normal;
    color: #f1f4fb;
}

#brand-subtitle {
    font-size: 9px;
    font-weight: 700;
    color: #5b6275;
    letter-spacing: 2.2px;
}

#sidebar-section {
    color: #4d5468;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.6px;
    padding: 12px 26px 6px 26px;
}

#nav-count {
    background-color: rgba(99, 102, 241, 0.22);
    color: #a5b4fc;
    border-radius: 9px;
    min-width: 18px;
    max-width: 18px;
    min-height: 18px;
    max-height: 18px;
    font-size: 10px;
    font-weight: 800;
}

#sidebar-version {
    color: #3a4052;
    font-size: 10px;
    font-weight: 700;
    padding-top: 4px;
}

#nav-btn {
    text-align: left;
    padding: 11px 16px 11px 18px;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0;
    margin: 1px 10px;
    background: transparent;
    color: #8a90a2;
    font-weight: 600;
    font-size: 13px;
}

#nav-btn:hover {
    background-color: rgba(255, 255, 255, 0.04);
    color: #d7dbe8;
}

#nav-btn:checked {
    background-color: rgba(99, 102, 241, 0.14);
    border-left: 3px solid #6366f1;
    color: #ffffff;
}

#nav-btn:checked:hover {
    background-color: rgba(99, 102, 241, 0.20);
}

#sidebar-footer {
    background-color: transparent;
}

/* ------------------------------------------------------------
   Toolbar
   ------------------------------------------------------------ */
#toolbar {
    background-color: rgba(17, 20, 28, 0.92);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding: 10px 18px;
}

#primary-btn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #6366f1, stop:1 #0ea5e9);
    border: none;
    border-radius: 9px;
    padding: 9px 22px;
    color: #ffffff;
    font-weight: 700;
    font-size: 13px;
}

#primary-btn:hover {
    background-color: #5558e3;
}

#primary-btn:pressed {
    background-color: #4a4dd6;
}

#secondary-btn {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 9px;
    padding: 9px 16px;
    color: #c9cedd;
    font-weight: 600;
}

#secondary-btn:hover {
    background-color: rgba(255, 255, 255, 0.09);
    border-color: rgba(255, 255, 255, 0.18);
    color: #ffffff;
}

#secondary-btn:pressed {
    background-color: rgba(255, 255, 255, 0.03);
}

#danger-btn {
    background-color: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.35);
    border-radius: 9px;
    padding: 9px 16px;
    color: #f87171;
    font-weight: 600;
}

#danger-btn:hover {
    background-color: rgba(239, 68, 68, 0.22);
    color: #ffffff;
}

#toolbar-search {
    background-color: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9px;
    padding: 8px 14px;
    color: #e8eaf2;
    min-width: 210px;
}

#toolbar-search:focus {
    border: 1px solid rgba(99, 102, 241, 0.7);
}

/* ------------------------------------------------------------
   Content / Cards
   ------------------------------------------------------------ */
#content-area {
    background-color: #0c0e14;
}

#page-header-title {
    font-family: "Rosehot free version", "Rosehot", "Inter", sans-serif;
    font-size: 24px;
    font-weight: normal;
    color: #f1f4fb;
}

#page-header-sub {
    font-size: 12px;
    color: #7a8095;
}

/* Standardized text roles — every view uses these, no inline fonts */
#dialog-title {
    font-family: "Rosehot free version", "Rosehot", "Inter", sans-serif;
    font-size: 24px;
    font-weight: normal;
    color: #f1f4fb;
}

#card {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
}

#card QLabel {
    color: #e2e8f0;
    font-size: 13px;
}

#page-view {
    background-color: transparent;
}

#page-header-subtitle {
    color: #94a3b8;
    font-size: 13px;
}

#section-title {
    font-size: 13px;
    font-weight: 800;
    color: #d3d7e5;
}

#section-sub {
    font-size: 11px;
    color: #7a8095;
}

#field-label {
    font-size: 11px;
    font-weight: 800;
    color: #7a8095;
    letter-spacing: 1.2px;
}

#media-title {
    font-size: 15px;
    font-weight: 700;
    color: #38bdf8;
}

#quality-info {
    font-size: 12px;
    color: #7a8095;
}

#muted-text {
    font-size: 12px;
    color: #8a90a2;
}

#hint-text {
    font-size: 12px;
    color: #7a8095;
}

#panel-title {
    font-size: 11px;
    font-weight: 800;
    color: #a5b4fc;
    letter-spacing: 1.2px;
}

#save-status {
    font-size: 12px;
    font-weight: 700;
    color: #4ade80;
}

#file-table {
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 10px;
}

#card {
    background-color: #151922;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px;
}

#stat-card {
    background-color: #151922;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px;
}

#stat-card:hover {
    border: 1px solid rgba(59, 130, 246, 0.4);
}

#stat-title {
    font-size: 11px;
    font-weight: 700;
    color: #7a8095;
    letter-spacing: 0.8px;
}

#stat-value {
    font-size: 24px;
    font-weight: 800;
    color: #f1f4fb;
}

#stat-sub {
    font-size: 11px;
    color: #5b6275;
}

#stat-icon {
    font-size: 20px;
    color: #4f46e5;
}

/* ------------------------------------------------------------
   Tables
   ------------------------------------------------------------ */
#download-table {
    background-color: transparent;
    alternate-background-color: rgba(255, 255, 255, 0.02);
    border: none;
    gridline-color: transparent;
    outline: none;
    selection-background-color: rgba(99, 102, 241, 0.16);
    selection-color: #ffffff;
}

#download-table::item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    padding: 6px;
}

QHeaderView {
    background-color: transparent;
}

QHeaderView::section {
    background-color: transparent;
    color: #6b7288;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.7px;
}

QTableView::item:selected {
    background-color: rgba(99, 102, 241, 0.16);
}

/* ------------------------------------------------------------
   Status badges
   ------------------------------------------------------------ */
QLabel[badge="true"] {
    border-radius: 11px;
    padding: 3px 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.4px;
}

QLabel[badge="true"][badgeClass="success"] {
    background-color: rgba(34, 197, 94, 0.14);
    color: #4ade80;
    border: 1px solid rgba(34, 197, 94, 0.35);
}

QLabel[badge="true"][badgeClass="danger"] {
    background-color: rgba(239, 68, 68, 0.14);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.35);
}

QLabel[badge="true"][badgeClass="warning"] {
    background-color: rgba(245, 158, 11, 0.14);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.35);
}

QLabel[badge="true"][badgeClass="info"] {
    background-color: rgba(56, 189, 248, 0.14);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.35);
}

QLabel[badge="true"][badgeClass="primary"] {
    background-color: rgba(59, 130, 246, 0.16);
    color: #7daaff;
    border: 1px solid rgba(59, 130, 246, 0.4);
}

QLabel[badge="true"][badgeClass="muted"] {
    background-color: rgba(255, 255, 255, 0.06);
    color: #9aa1b4;
    border: 1px solid rgba(255, 255, 255, 0.10);
}

/* ------------------------------------------------------------
   Progress bars
   ------------------------------------------------------------ */
QProgressBar {
    background-color: rgba(255, 255, 255, 0.07);
    border: none;
    border-radius: 5px;
    height: 10px;
    text-align: center;
    color: transparent;
    font-size: 9px;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                      stop:0 #6366f1, stop:1 #0ea5e9);
    border-radius: 5px;
}

/* ------------------------------------------------------------
   Inputs
   ------------------------------------------------------------ */
QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 9px;
    padding: 9px 12px;
    color: #e8eaf2;
    selection-background-color: #4f46e5;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QSpinBox:focus {
    border: 1px solid rgba(99, 102, 241, 0.75);
}

QComboBox {
    background-color: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 9px;
    padding: 8px 12px;
    color: #e8eaf2;
}

QComboBox:focus {
    border: 1px solid rgba(99, 102, 241, 0.75);
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #8a90a2;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #1a1f2b;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 9px;
    selection-background-color: rgba(99, 102, 241, 0.40);
    padding: 4px;
}

QCheckBox {
    spacing: 8px;
    color: #c9cedd;
}

QCheckBox::indicator {
    width: 17px;
    height: 17px;
    border-radius: 5px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background-color: rgba(0, 0, 0, 0.35);
}

QCheckBox::indicator:checked {
    background-color: #6366f1;
    border-color: #6366f1;
    image: none;
}

QCheckBox::indicator:hover {
    border-color: #6366f1;
}

QSlider::groove:horizontal {
    height: 5px;
    background-color: rgba(255, 255, 255, 0.10);
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #6366f1;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 15px;
    height: 15px;
    margin: -5px 0;
    border-radius: 8px;
    background-color: #0ea5e9;
}

/* ------------------------------------------------------------
   Scrollbars
   ------------------------------------------------------------ */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.14);
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.25);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.14);
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ------------------------------------------------------------
   Group boxes / sections
   ------------------------------------------------------------ */
QGroupBox {
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    margin-top: 18px;
    padding: 14px 12px 10px 12px;
    background-color: rgba(255, 255, 255, 0.015);
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #a5b4fc;
    font-weight: 700;
}

/* ------------------------------------------------------------
   Buttons (generic)
   ------------------------------------------------------------ */
QPushButton {
    border-radius: 9px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton:disabled {
    color: rgba(232, 234, 242, 0.35);
    background-color: rgba(255, 255, 255, 0.05);
}

/* ------------------------------------------------------------
   Menus & Tooltips
   ------------------------------------------------------------ */
QMenu {
    background-color: #1a1f2b;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 26px 8px 14px;
    border-radius: 7px;
    color: #d3d7e5;
}

QMenu::item:selected {
    background-color: rgba(99, 102, 241, 0.40);
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.08);
    margin: 5px 10px;
}

QToolTip {
    background-color: #1a1f2b;
    color: #e8eaf2;
    border: 1px solid rgba(99, 102, 241, 0.5);
    border-radius: 6px;
    padding: 6px 10px;
}

/* ------------------------------------------------------------
   Tabs
   ------------------------------------------------------------ */
QTabWidget::pane {
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    background-color: #151922;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #8a90a2;
    padding: 9px 18px;
    border-bottom: 2px solid transparent;
    font-weight: 600;
}

QTabBar::tab:selected {
    color: #ffffff;
    border-bottom: 2px solid #6366f1;
}

QTabBar::tab:hover:!selected {
    color: #d7dbe8;
}

/* ------------------------------------------------------------
   Misc
   ------------------------------------------------------------ */
QLabel#link-label, QLabel[link="true"] {
    color: #a5b4fc;
}

QLabel[link="true"]:hover {
    color: #38bdf8;
    text-decoration: underline;
}

QStatusBar {
    background-color: #11141c;
    color: #8a90a2;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
}

QStatusBar::item {
    border: none;
}

#status-active {
    color: #8a90a2;
    font-size: 11px;
    padding-left: 12px;
}

#status-total {
    color: #8a90a2;
    font-size: 11px;
    padding-right: 14px;
}

#status-speed {
    color: #38bdf8;
    font-size: 11px;
    font-weight: 700;
    padding-right: 14px;
}

QMessageBox, QInputDialog {
    background-color: #0c0e14;
}
